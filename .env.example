# ====================================
# LogixSense — Environment Variables
# ====================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# Groq API Key (for AI-powered logistics insights)
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# OpenWeather API Key (for real-time weather-based route risk)
# Get yours at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Server Port (optional, defaults to 8888)
# PORT=8888
